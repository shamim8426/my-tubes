{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -X utf8 tools/youtube_upload.py:*)",
      "Bash(.venv/Scripts/python.exe -X utf8 tools/post_comment.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 1200
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -X utf8 \"${CLAUDE_PROJECT_DIR}/scripts/state.py\" guard",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/tools/sync_bg.ps1\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/session_end_cloud.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
