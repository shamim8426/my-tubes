   "kind": "line",
   "n": 24,
   "speaker": "ustaad",
   "role": "matlab",
   "section": "3. AAYAT-DAR-AAYAT",
   "ayah": 4,
   "text": "'सिनह' यानी ऊँघ, 'नौम' यानी गहरी नींद — दोनों नहीं। उसे कभी कोई कमी या बेख़बरी नहीं।",
   "tags": [
    "U3"
   ],
   "audio": "audio/tts/024_ustaad.wav",
