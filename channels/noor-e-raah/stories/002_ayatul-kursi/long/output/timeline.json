   "kind": "line",
   "n": 18,
   "speaker": "ustaad",
   "role": "matlab",
   "section": "3. AAYAT-DAR-AAYAT",
   "ayah": 3,
   "text": "'हय्य' यानी हमेशा ज़िंदा — जिसे कभी मौत नहीं आती।",
   "tags": [
    "U2"
   ],
   "audio": "audio/tts/018_ustaad.wav",
   "seconds": 5.84,
   "tts_ok": true,
   "start": 85.241,
   "end": 90.648
  },
