   "n": 77,
   "speaker": "ustaad",
   "role": "ucharan",
   "section": "3. AAYAT-DAR-AAYAT",
   "ayah": 8,
   "text": "वला युहीतूना बि शैइन मिन इल्मिही इल्ला बिमा शा",
   "tags": [],
   "audio": "audio/tts/077_ustaad.wav",
