   "n": 9,
   "speaker": "ustaad",
   "role": "",
   "section": "2. SHAN-E-NUZUL",
   "ayah": null,
   "text": "ज़्यादातर उलमा के मुताबिक़ ये मक्की सूरह है। क़तादा वग़ैरह कुछ ने इसे मदनी भी कहा है।",
   "tags": [
    "P2"
   ],
   "audio": "audio/tts/009_ustaad.wav",
