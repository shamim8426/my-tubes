# ---- secrets: never on GitHub ----
.env
secrets/
**/client_secret*.json
**/youtube_token*.json
*.pem
.claude/settings.local.json

# ---- big media: not on GitHub ----
*.mp4
*.mov
*.mkv
*.webm
*.avi

# ---- regenerable caches / models ----
# (Claude Code: add only FREE-to-regenerate cache folders here.
#  Paid outputs - Gemini images, TTS audio - must stay tracked.)
__pycache__/
*.pyc
*.pt
.venv/
venv/
# encoded scene clips (make_short rebuilds them from images + TTS cache, free)
cache/
# build temp: mixed wavs, framecheck frames, ass files (free, rebuilt every build)
**/output/*_work/
# Munshi review working files (frames, sheets, stems: regenerable, large); only the .md reports go to GitHub
**/review/**
!**/review/*.md
# big downloadable binaries / models (deploy.ps1 installs ffmpeg; whisper model auto-downloads)
tools/ffmpeg/
tools/deno/
tools/whisper-models/
# 2.5D parallax depth model (Depth Anything V2 Small, Apache-2.0; deploy.ps1 downloads it)
models/
**/images/_depth/
tools/yt-dlp.exe
# Claude account's auto-synced built-in skills (come back by themselves after login)
claude-home/skills/synced/

# music/ambience OPTIONS not yet picked (free to download again; picked tracks move out and are tracked)
shared/music/noor/_options/
shared/sfx/noor/_options/

# Noor-e-Raah sample build temp files (free to rebuild)
channels/noor-e-raah/samples/**/_*
# Noor-e-Raah render temp files (stems, ASS, text files; rebuilt free by scripts/noor_render.py)
channels/noor-e-raah/stories/*/long/output/_*

# ---- misc ----
# study downloads (RULES 12c): local only, deleted within 24 h, never on GitHub
study/
_to_delete/
Thumbs.db
desktop.ini

# chat history (SpecStory): stays on this PC only, never on GitHub (2026-10-20)
.specstory/
